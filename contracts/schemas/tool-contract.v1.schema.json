{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.buildgrid.app/tool-contract/v1",
  "title": "BuildGrid Tool Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "contract_version",
    "display_name",
    "description",
    "input_schema",
    "anchor_schema",
    "context_schema",
    "material_roles",
    "output_schema",
    "metadata_schema",
    "capabilities",
    "commercial",
    "source_references",
    "known_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "buildgrid.tool-contract.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^buildgrid\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[1-9][0-9]*$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "input_schema": {
      "type": "object"
    },
    "anchor_schema": {
      "type": "object"
    },
    "context_schema": {
      "type": "object"
    },
    "material_roles": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "metadata_schema": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "preview", "build", "inspect", "rebuild", "delete", "ai_enabled", "production_ready"],
      "properties": {
        "validate": { "const": true },
        "preview": { "type": "boolean" },
        "build": { "type": "boolean" },
        "inspect": { "type": "boolean" },
        "rebuild": { "type": "boolean" },
        "delete": { "type": "boolean" },
        "ai_enabled": { "type": "boolean", "default": false },
        "production_ready": { "type": "boolean", "default": false }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceable", "catalogue_ids", "takeoff_scope", "takeoff_exclusions", "authoritative_quantity_carriers", "rule_surfaces", "catalogue_dependencies"],
      "properties": {
        "priceable": { "type": "boolean" },
        "catalogue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "takeoff_scope": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "takeoff_exclusions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "authoritative_quantity_carriers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rule_surfaces": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "catalogue_dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "known_limits": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "locator", "purpose", "authority", "compliance_authority", "applies_to"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["standard", "manufacturer", "builder_policy", "dataset", "research", "other"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "authority": { "type": "string", "minLength": 1, "maxLength": 300 },
        "compliance_authority": { "type": "boolean" },
        "edition": { "type": ["string", "null"], "maxLength": 100 },
        "coverage_sections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "applies_to": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      }
    }
  }
}
