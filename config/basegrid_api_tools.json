[
  {
    "name": "basegrid_status",
    "description": "Inspect Basegrid, the current model, selected face references and material connection status. Call before drawing.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_list_materials",
    "description": "List cached material IDs, dimension metadata and material types, plus slab takeoff groups. Set concrete_only=false for other tools. No signed URLs or local paths are returned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "concrete_only": {
          "type": "boolean"
        },
        "query": {
          "type": "string",
          "description": "Optional material name search.",
          "maxLength": 512
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_sync_materials",
    "description": "Sync the web material library using the existing local Basegrid sign-in. Credentials are never returned. If disconnected, the user must use Extensions > Basegrid > Materials > Connect.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "basegrid_create_slab",
    "description": "Create one Basegrid concrete slab below a horizontal face in the current editing context, retaining the source and its openings. One undo step. Uses a Basegrid face_ref, or exactly one selected face. Dimensions are millimetres. Returns native entity reference and takeoff.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "description": "model_guid returned by basegrid_status; prevents drawing into a different model.",
          "maxLength": 512,
          "minLength": 1
        },
        "replace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Optional unlocked slab group in the active context to replace in one Undo operation. Supply the desired thickness, material and source face (face_ref or single selected horizontal face); not a partial patch. The source face is retained."
        },
        "face_ref": {
          "type": "string",
          "description": "Basegrid session reference, e.g. bg_session_12. Omit to use the current single-face selection.",
          "maxLength": 512,
          "minLength": 1
        },
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "material_id": {
          "type": "string",
          "description": "Compatible concrete material ID from basegrid_list_materials.",
          "maxLength": 512,
          "minLength": 1
        },
        "takeoff_group_id": {
          "type": "string",
          "description": "Permitted group ID; omit or use an empty string for Unassigned.",
          "maxLength": 512
        }
      },
      "required": [
        "model_guid",
        "thickness_mm",
        "material_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_takeoff",
    "description": "Read stored Basegrid takeoff quantities and grouped totals, or return CSV text. Quantities are recorded at creation, not recalculated after manual geometry changes. CSV is returned to Claude, not written to disk.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "Output format.",
          "maxLength": 512,
          "enum": [
            "json",
            "csv"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_set_appearance",
    "description": "Set all generated Basegrid objects to model or display appearance in one undo step, preserving material IDs and takeoff.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "description": "model_guid returned by basegrid_status; prevents drawing into a different model.",
          "maxLength": 512,
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "description": "Appearance to apply.",
          "maxLength": 512,
          "enum": [
            "model",
            "display"
          ]
        }
      },
      "required": [
        "model_guid",
        "mode"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_set_slab_tag_folder",
    "description": "Set the user's default folder for newly created slab role tags. Existing tag placement stays as it is.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string",
          "description": "Folder path, e.g. Structure/Concrete. Empty string means no folder.",
          "maxLength": 512
        }
      },
      "required": [
        "folder"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_tool_catalog",
