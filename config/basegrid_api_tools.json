      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_find_objects",
    "description": "Search Basegrid's building-object ontology by name or ID, or retrieve one full object and its outgoing relationships. These records describe construction objects, not engineered design choices.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Case-insensitive name or ID search.",
          "maxLength": 512
        },
        "object_id": {
          "type": "string",
          "description": "Exact ontology object ID.",
          "maxLength": 512,
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_native_api",
