      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_invoke",
    "description": "Invoke one supported native SketchUp API method through Basegrid. Use basegrid_native_api for allowed methods. Writes are undoable. Point3d and Length arguments require explicit units.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Current model_guid returned by basegrid_status."
        },
        "target": {
          "type": "object",
          "description": "{\"$root\":\"active_model\"}, {\"$ref\":\"bg_...\"} or {\"$result\":\"earlier-call-id\"} (batch only)."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Native method from basegrid_native_api."
        },
        "arguments": {
          "type": "array",
          "maxItems": 32
        }
      },
      "required": [
        "model_guid",
        "target",
        "method"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_batch",
    "description": "Execute up to 100 native SketchUp API calls in order. Geometry writes share one Undo operation; failures abort it. Each call has id, target, method and optional arguments. Later calls can use an earlier $result.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Current model_guid returned by basegrid_status."
        },
        "operation_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Undo label."
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Unique call ID."
              },
              "target": {
                "type": "object",
                "description": "{\"$root\":\"active_model\"}, {\"$ref\":\"bg_...\"} or {\"$result\":\"earlier-call-id\"} (batch only)."
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Native method."
              },
              "arguments": {
                "type": "array",
                "maxItems": 32
              }
            },
            "required": [
              "id",
              "target",
              "method"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "model_guid",
        "calls"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_capture_view",
    "description": "Return a PNG image of the current SketchUp viewport.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_create_strip_footing",
    "description": "Create one connected strip footing assembly with horizontal paths at any angle, one joined concrete solid including step overlaps, optional top/bottom mesh, rectangular support instances and paired-bar spacer instances. Reinforcement connections are NOT detailed. Paths use world millimetres; each path is horizontal, with different-height paths meeting at straight steps. Unassigned materials are allowed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "minLength": 1,
          "description": "Current model_guid from basegrid_status."
        },
        "replace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Optional unlocked strip footing group in the active context to replace in one Undo operation. Supply complete desired world paths, settings and material bindings, not a partial patch. Geometry and takeoff are regenerated."
        },
        "paths_mm": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "Array of paths, each containing 2–100 [x,y,z] points in world millimetres. Close loops by repeating the first point. Add branches or steps as additional paths.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "description": "[x,y,z] in world millimetres."
            }
          }
        },
        "settings": {
          "type": "object",
          "description": "Optional width_mm, depth_mm, alignment (center/left_edge/right_edge), vertical_reference (top/bottom), step_overlap_mm, reinforcement (none/bottom/top_bottom; defaults top_bottom), bar_count (3/4), bar_spacing_mm, bar_diameter_mm, cross_diameter_mm, cross_spacing_mm, support_spacing_mm, support_width_mm, support_first_offset_mm, spacer_diameter_mm, spacer_pair_offset_mm. Dimensions in mm. Clear cover is fixed at 50 mm; legacy cover_mm values are overridden. Selected material dimensions override corresponding settings. Supports are fixed 50 mm high; Bogar spacer height is footing depth minus 100 mm. Legacy support_thickness_mm is ignored.",
          "properties": {
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "step_overlap_mm": {
              "description": "Step backfill length in mm. Defaults to 1.5 times footing depth when omitted.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "step_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "include_step_z_bars": {
              "type": "boolean",
              "description": "Enable automatic step Z bars; defaults false. Bars are created only where step height is strictly greater than step_z_threshold_mm."
            },
            "include_piers": {
              "type": "boolean",
              "description": "Include independently editable concrete piers under the footing; defaults false. Piers use the footing concrete material."
            },
            "pier_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Maximum pier centres, defaults 1800 mm."
            },
            "piers_at_corners": {
              "type": "boolean",
              "description": "Require a pier at each centreline corner; defaults true."
            },
            "piers_at_intersections": {
              "type": "boolean",
              "description": "Require one shared pier at T/cross intersections; defaults true."
            },
            "piers_even_spacing": {
              "type": "boolean",
              "description": "Distribute centres evenly without exceeding the maximum; defaults true. False uses nominated spacing with an end remainder."
            },
            "pier_diameter_mm": {
              "type": "number",
              "minimum": 1,
              "description": "Defaults 450 mm."
            },
            "pier_depth_mm": {
              "type": "number",
              "minimum": 1,
              "description": "Depth below the footing underside; defaults 600 mm."
            },
            "pier_add_bar": {
              "type": "boolean",
              "description": "Include a starter in each pier; defaults false. Material diameter comes from materials.pier_bar."
            },
            "pier_bar_below_mm": {
              "type": "number",
              "minimum": 0,
              "description": "Defaults to pier depth minus 100 mm."
            },
            "pier_bar_above_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Rise from pier top into footing; defaults to half the footing depth."
            },
            "pier_bar_cog_mm": {
              "type": "number",
              "minimum": 0,
              "description": "Upper cog across footing; defaults to footing width divided by 2 minus 50 mm."
            },
            "step_z_threshold_mm": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum step height without Z bars; defaults 200 mm. Equal-height steps do not receive Z bars."
            },
            "step_z_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Resolved diameter retained in assembly metadata; selected Z-bar material overrides this value. Lap legs are 50 times diameter."
            },
            "bar_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bar_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cross_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cross_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "support_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "support_width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "support_first_offset_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spacer_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spacer_pair_offset_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "spacer_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "alignment": {
              "type": "string",
              "enum": [
                "center",
                "left_edge",
                "right_edge"
              ]
            },
            "vertical_reference": {
              "type": "string",
              "enum": [
                "top",
                "bottom"
              ]
            },
            "reinforcement": {
              "type": "string",
              "enum": [
                "none",
                "bottom",
                "top_bottom"
              ]
            },
            "double_mesh": {
              "type": "string",
              "enum": [
                "none",
                "top",
                "bottom",
                "top_bottom"
              ],
              "description": "Two trench mesh strips on the nominated existing mesh layers. Fixed 50 mm side cover; at most 100 mm clear between strips. Lapped strips stack vertically. Defaults to none."
            },
            "bar_count": {
              "type": "integer",
              "enum": [
                3,
                4
              ]
            },
            "cover_mm": {
              "type": "number",
              "description": "Legacy input ignored; clear cover is always 50 mm."
            },
            "support_thickness_mm": {
              "type": "number",
              "description": "Legacy input ignored; supports are always 50 mm high."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "materials": {
          "type": "object",
          "description": "Concrete, mesh, chairs, spacers and z_bars material UUIDs. z_bars requires a Reo Bar Processed material measured in metres with valid diameter whenever qualifying Z bars are generated. Other missing roles remain unassigned.",
          "properties": {
            "concrete": {
              "type": "string"
            },
            "mesh": {
              "type": "string"
            },
            "chairs": {
              "type": "string"
            },
            "spacers": {
              "type": "string"
            },
            "z_bars": {
              "type": "string"
            },
            "pier_bar": {
              "type": "string",
              "description": "Reo Bar Processed material for optional pier starters. Diameter is read from metadata."
            },
            "pier_concrete": {
              "type": "string",
              "description": "Optional separate concrete material for footing piers. When omitted, uses the footing concrete material."
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "model_guid",
        "paths_mm"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_create_starter_bars",
    "description": "Create straight/tapered starter bars or pins along an ordered path. Spacing uses horizontal chainage; Z follows the path. Close loops by repeating the first point. Maximum 5,000 eight-sided bars. Requires extension 0.3.2+. World coordinates in millimetres; no UI opens. Returns entity reference, resolved parameters and takeoff.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "minLength": 1,
          "description": "Current model_guid from basegrid_status."
        },
        "replace_ref": {
          "type": "string",
          "description": "Optional unlocked group of this tool in the active context to replace in one Undo operation. Supply complete desired geometry/settings, not a partial patch."
        },
        "points_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000000000,
              "maximum": 1000000000
            },
            "description": "[x,y,z] in world millimetres."
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "straight",
                "tapered",
                "pins"
              ]
            },
            "spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "first_offset_mm": {
              "type": "number",
              "minimum": 0
            },
            "above_mm": {
              "type": "number",
              "minimum": 0
            },
            "below_mm": {
              "type": "number",
              "minimum": 0
            },
            "top_start_mm": {
              "type": "number",
              "minimum": 0
            },
            "top_end_mm": {
              "type": "number",
              "minimum": 0
            },
            "bottom_start_mm": {
              "type": "number",
              "minimum": 0
            },
            "bottom_end_mm": {
              "type": "number",
              "minimum": 0
            },
            "top_direction": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            },
            "bottom_direction": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            },
            "in_mm": {
              "type": "number",
              "minimum": 0
            },
            "out_mm": {
              "type": "number",
              "minimum": 0
            },
            "chairs": {
              "type": "boolean"
            },
            "caps": {
              "type": "boolean"
            },
            "bar_material": {
              "type": "string",
              "description": "Bar material ID; metadata supplies diameter. Empty means unassigned nominal 12 mm."
            },
            "chair_material": {
              "type": "string",
              "description": "Material type Bar Chairs."
            },
            "cap_material": {
              "type": "string",
              "description": "Material type Reo Bar Safety Caps."
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "Omitted settings use tool defaults, not saved UI preferences. Material metadata supplies derived dimensions."
        },
        "anchor_mm": {
          "type": "number",
          "minimum": 0
        },
        "reverse": {
          "type": "boolean"
        }
      },
      "required": [
        "model_guid",
        "points_mm"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "basegrid_create_step_z_bars",
    "description": "Create eight-sided Step Z bars between explicit pairs of bar centreline endpoints at different levels. Upper/lower are sorted by height; at least 1 mm rise required. Requires extension 0.3.2+. World coordinates in millimetres; no UI opens. Returns entity reference, resolved parameters and takeoff.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model_guid": {
          "type": "string",
          "minLength": 1,
          "description": "Current model_guid from basegrid_status."
        },
        "replace_ref": {
          "type": "string",
          "description": "Optional unlocked group of this tool in the active context to replace in one Undo operation. Supply complete desired geometry/settings, not a partial patch."
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "upper": {
                "type": "object",
